---
import '../styles/global.css';
import Kopf from '../components/Kopf.astro';
import Fuss from '../components/Fuss.astro';
import Leiste from '../components/Leiste.astro';
import { betrieb } from '../data/betrieb';

interface Props {
  titel: string;
  beschreibung: string;
  whatsappText?: string;
  keinIndex?: boolean;
}
const { titel, beschreibung, whatsappText, keinIndex = false } = Astro.props;
const kanonisch = new URL(Astro.url.pathname, Astro.site);
const ogBild = new URL('/og-bild.jpg', Astro.site);

const firmendaten = {
  '@context': 'https://schema.org',
  '@type': 'HomeAndConstructionBusiness',
  '@id': `${Astro.site}#betrieb`,
  name: `${betrieb.name} – ${betrieb.zusatz}`,
  url: Astro.site?.toString(),
  logo: new URL('/favicon.svg', Astro.site).toString(),
  image: ogBild.toString(),
  telephone: '+49 172 4300736',
  email: betrieb.email,
  founder: { '@type': 'Person', name: betrieb.inhaber, jobTitle: betrieb.beruf },
  foundingDate: '2023-11',
  address: {
    '@type': 'PostalAddress',
    streetAddress: betrieb.strasse,
    postalCode: betrieb.plz,
    addressLocality: betrieb.ort,
    addressRegion: 'Niedersachsen',
    addressCountry: 'DE',
  },
  areaServed: betrieb.einzugsgebiet.map((o) => ({ '@type': 'City', name: o })),
  knowsAbout: ['Umbau', 'Sanierung', 'Renovierung', 'Innenputz', 'Estrich', 'Rohbau', 'Mauerwerksbau', 'Klinker', 'Beton- und Stahlbetonarbeiten', 'Pflasterarbeiten', 'Gebäudeentwässerung'],
};
---
<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titel}</title>
    <meta name="description" content={beschreibung} />
    <link rel="canonical" href={kanonisch} />
    {keinIndex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#F4F1EC" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preload" href="/fonts/archivo-var.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/source-sans-3-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="de_DE" />
    <meta property="og:site_name" content={betrieb.name} />
    <meta property="og:title" content={titel} />
    <meta property="og:description" content={beschreibung} />
    <meta property="og:url" content={kanonisch} />
    <meta property="og:image" content={ogBild} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <script type="application/ld+json" set:html={JSON.stringify(firmendaten)} />
    <script is:inline>document.documentElement.classList.add('js')</script>
    <slot name="kopf" />
  </head>
  <body>
    <a class="skip" href="#inhalt">Zum Inhalt springen</a>
    <Kopf />
    <main id="inhalt">
      <slot />
    </main>
    <Fuss />
    <Leiste whatsappText={whatsappText} />
    <script>
      const elemente = document.querySelectorAll('.einblenden');
      if ('IntersectionObserver' in window) {
        const beobachter = new IntersectionObserver((eintraege) => {
          for (const e of eintraege) {
            if (e.isIntersecting) { e.target.classList.add('ist-sichtbar'); beobachter.unobserve(e.target); }
          }
        }, { rootMargin: '0px 0px -8% 0px' });
        elemente.forEach((el) => beobachter.observe(el));
      } else {
        elemente.forEach((el) => el.classList.add('ist-sichtbar'));
      }
    </script>
  </body>
</html>
