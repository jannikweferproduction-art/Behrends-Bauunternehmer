---
import Basis from '../layouts/Basis.astro';
---
<Basis titel="Seite nicht gefunden – Besser bauen Behrends" beschreibung="Diese Seite gibt es nicht." keinIndex>
  <section class="abschnitt">
    <div class="wrap">
      <div class="rollschicht" aria-hidden="true" style="max-width:10rem;margin-bottom:2rem"></div>
      <p class="schicht"><b>404</b>Seite nicht gefunden</p>
      <h1 style="font-size:var(--t-h1);max-width:16ch">Hier fehlt ein Stein.</h1>
      <p class="lead">Die Seite gibt es nicht (mehr). Von hier aus geht es weiter:</p>
      <div class="weitere" style="max-width:48rem">
        <a href="/">Startseite<span aria-hidden="true">→</span></a>
        <a href="/kontakt/">Kontakt<span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>
</Basis>
